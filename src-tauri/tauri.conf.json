{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "奇幻钢琴屋",
  "version": "1.1.0",
  "identifier": "com.huijiangyuan.fantasypianohouse",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "奇幻钢琴屋",
        "width": 1100,
        "height": 720,
        "minWidth": 360,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "info": {
        "NSAppleEventsUsageDescription": "奇幻钢琴屋需要辅助功能权限以在系统级拦截功能键与系统快捷键。",
        "NSInputMonitoringUsageDescription": "奇幻钢琴屋需要输入监控权限以在系统级拦截功能键。"
      }
    }
  }
}
